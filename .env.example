OPENAI_API_KEY=
# Modelo para la clasificación de intención del bot (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Máx. tokens de la respuesta del clasificador (default: 150)
MAX_TOKENS=150
# Usar GPT para clasificar; si es False o falta la API key, usa solo palabras clave
USE_GPT_ANALYZER=True
DATABASE_URL="mysql://user:password@localhost:3306/name_db"

# NOTE: use the legacy sendinblue hostname — algunos nodos regionales de Brevo
# presentan certs cuyas altnames solo incluyen *.sendinblue.com, no *.brevo.com.
BREVO_SMTP_HOST="smtp-relay.sendinblue.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="dummy-login@smtp-brevo.com"
BREVO_SMTP_PASSWORD="dummy-master-password"
MAIL_FROM_EMAIL="no-reply@humanika.co"
MAIL_FROM_NAME="150%"

# --- Acceso al panel de administración (/login -> /dashboard) ---
# El usuario admin vive en la tabla AdminUser (contraseña hasheada con scrypt).
# Se crea/actualiza con: npm run seed
# (opcional) sobreescribe las credenciales del seed:
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_PASSWORD="una-contrasena-fuerte"
#
# Secreto para firmar la cookie de sesión (HMAC). Usa una cadena larga y aleatoria,
# p. ej.: openssl rand -hex 32
AUTH_SECRET=

# --- reCAPTCHA v3 (formulario de contacto del home) ---
# Claves de https://www.google.com/recaptcha/admin — el dominio de producción y
# localhost deben estar dados de alta ahí o siteverify devuelve score 0.
# La clave de sitio viaja al navegador (por eso NEXT_PUBLIC_); la secreta jamás.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# Score mínimo aceptado (0.0 bot ↔ 1.0 humano). Google recomienda 0.5.
RECAPTCHA_MIN_SCORE="0.5"